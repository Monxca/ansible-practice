---
- name: Prompting the user to type
  hosts: local
  connection: local

  vars_prompt:
    - name: username
      prompt: What is your name?
      private: false

    - name: password
      prompt: Type your password here - 
      private: true

  tasks:
    - name: Print the output
      debug:
        msg: Hello, my name is {{ username }} and password is {{ password }}